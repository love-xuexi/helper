# ============================================================
# SuperBizAgent 环境变量模板
# 使用方法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#   Windows PowerShell:  Copy-Item .env.example .env
# ============================================================

# 应用配置
APP_NAME=SuperBizAgent
DEBUG=true
HOST=0.0.0.0
PORT=9900

# Chat LLM 配置（DeepSeek，使用 LangChain 官方 ChatDeepSeek 接口）
# 到 https://platform.deepseek.com/api_keys 申请 API Key
CHAT_API_KEY=sk-
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# Embedding 配置
EMBEDDING_API_KEY=sk-
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENCODING_FORMAT=float

# Rerank 配置
RERANK_ENABLED=true
RERANK_PROVIDER=openai_compatible
RERANK_API_KEY=sk-
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=30

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_CANDIDATE_TOP_K=20

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio（本地进程）、streamable-http（HTTP 流）
# 也可以配置真实的 cls mcp 服务：https://cloud.tencent.com/developer/mcp/server/11710
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

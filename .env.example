# ============================================================
# SuperBizAgent 环境变量模板
# 使用方法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#   Windows PowerShell:  Copy-Item .env.example .env
# ============================================================

# 应用配置
APP_NAME=SuperBizAgent
DEBUG=true
HOST=0.0.0.0
PORT=9900

# Chat LLM 配置
# CHAT_PROVIDER 决定使用哪种 LangChain 接口：
#   deepseek -> ChatDeepSeek（默认，https://platform.deepseek.com/api_keys 申请 Key）
#   qwen     -> ChatQwen（DashScope）
#   openai   -> ChatOpenAI（OpenAI 兼容，无专用接口时的兜底）
# 留空则按 CHAT_BASE_URL / CHAT_MODEL 自动推断，无法识别时回退到 openai 兼容模式。
CHAT_PROVIDER=deepseek
CHAT_API_KEY=sk-
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ============================================================
# 知识库平台 API 配置（内网）
# 知识库的建立/解析/向量化/混合检索/重排均由知识库平台完成
# ============================================================
# Bearer Token，形如 kbmp-xxxx
KB_API_TOKEN=kbmp-
# 文档检索 / 上传接口
KB_DOC_BASE_URL=http://10.8.192.79:5353
# 知识库管理接口（知识库列表 / 文档列表 / 指定知识库检索）
KB_MGMT_BASE_URL=http://10.8.192.79:5354
# FAQ 问答库检索接口
KB_FAQ_BASE_URL=http://10.8.192.79:6000
# 机器人编码
KB_BOTCODE=
# FAQ 渠道
KB_FAQ_CHANNEL=
# 文件上传的默认目标知识库 ID（留空则取知识库列表第一个）
KB_UPLOAD_KB_ID=
# 接口超时（秒）
KB_TIMEOUT_SECONDS=30
# 传给 LLM 的最相关片段数量（3-5）
KB_MAX_CHUNKS=5
# 相似度过滤阈值（0 表示不过滤）
KB_MIN_SIMILARITY=0

# ============================================================
# 反馈评价系统配置
# ============================================================
# 本地 SQLite 存储路径
FEEDBACK_DB_PATH=data/feedback.db
# 可选：内网反馈入库接口，配置后反馈会同步转发
FEEDBACK_API_URL=

# 会话持久化配置
# memory: 默认进程内 MemorySaver；postgres: PostgreSQL checkpoint，服务重启后保留 Agent 状态
SESSION_CHECKPOINT_BACKEND=memory
POSTGRES_DSN=postgresql://superbiz:superbiz_dev@localhost:5432/super_biz_agent
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# MCP 服务配置
# 支持的 transport 类型：stdio（本地进程）、streamable-http（HTTP 流）
# 也可以配置真实的 cls mcp 服务：https://cloud.tencent.com/developer/mcp/server/11710
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

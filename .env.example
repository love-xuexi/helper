# ============================================================
# SuperBizAgent 环境变量模板
# 使用方法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#   Windows PowerShell:  Copy-Item .env.example .env
# ============================================================

# 应用配置
APP_NAME=SuperBizAgent
DEBUG=true
HOST=0.0.0.0
PORT=9983

# Chat LLM 配置
# CHAT_PROVIDER 决定使用哪种 LangChain 接口：
#   deepseek -> ChatDeepSeek（默认，https://platform.deepseek.com/api_keys 申请 Key）
#   qwen     -> ChatQwen（DashScope）
#   openai   -> ChatOpenAI（OpenAI 兼容，无专用接口时的兜底）
CHAT_PROVIDER=deepseek
CHAT_API_KEY=sk-
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ============================================================
# 知识库 API 配置（内网接口，RAG 检索直接调用，无需本地向量库）
# ============================================================
# 文档检索/上传地址（端口 5353）
KB_RETRIEVAL_BASE_URL=http://10.8.192.79:5353
# 知识库管理地址（端口 5354）
KB_MANAGEMENT_BASE_URL=http://10.8.192.79:5354
# FAQ 检索地址（端口 6000）
KB_FAQ_BASE_URL=http://10.8.192.79:6000
# 统一鉴权 Token
KB_API_TOKEN=kbmp-i94DZSu3_pUMxcA0seYAe-Hcod3_EJRf
# 文档检索用的 botcode
KB_BOTCODE=25d4c12e46834cc39bc211b84a9b2462
# FAQ 检索用的 botcode
KB_FAQ_BOTCODE=a2a45e52569f48ac9a2a2ca1d1e2718c
# FAQ 渠道
KB_FAQ_CHANNEL=1
# 默认检索的知识库 ID 列表（逗号分隔，留空则使用 botcode 关联的默认库）
KB_DEFAULT_KB_IDS=
# 检索返回的片段数量上限
KB_TOP_K=5
# 检索相似度阈值（低于此值的片段将被过滤）
KB_SIMILARITY_THRESHOLD=0.3
# KB API 请求超时（秒）
KB_TIMEOUT_SECONDS=30

# ============================================================
# 反馈系统配置
# ============================================================
# 反馈数据库路径（SQLite）
FEEDBACK_DB_PATH=./data/feedback.db
# 可选：反馈数据外部推送 API（留空则仅本地存储）
FEEDBACK_EXTERNAL_API_URL=
FEEDBACK_EXTERNAL_API_TOKEN=

# ============================================================
# Bug 上报系统配置
# ============================================================
# Bug 数据库路径（SQLite）
BUG_DB_PATH=./data/bug.db
# Bug 附件存储目录
BUG_UPLOAD_DIR=./data/uploads

# ============================================================
# 会话持久化配置
# ============================================================
# memory: 进程内 MemorySaver（默认）；postgres: PostgreSQL checkpoint
SESSION_CHECKPOINT_BACKEND=memory
POSTGRES_DSN=postgresql://superbiz:superbiz_dev@localhost:5432/super_biz_agent
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# ============================================================
# 以下为旧版本地向量库配置（已不再使用，保留仅为兼容）
# 如不需要本地向量库，可忽略以下配置
# ============================================================
# Embedding 配置（旧，已不再使用）
EMBEDDING_API_KEY=sk-
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENCODING_FORMAT=float

# Rerank 配置（旧，已不再使用）
RERANK_ENABLED=false
RERANK_PROVIDER=openai_compatible
RERANK_API_KEY=sk-
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=30

# Milvus 配置（旧，已不再使用）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# 文档分块配置（旧，已不再使用）
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置（可选，用于 AIOps 模块）
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
